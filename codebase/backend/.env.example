OPENAI_API_KEY=

# URLs of the locally-run MCP servers (see codebase/mcp/discord_mcp,
# codebase/mcp/google_calendar_mcp and codebase/mcp/gmail_mcp READMEs to
# start them). Defaults match those servers' default ports.
DISCORD_MCP_URL=http://localhost:8085/mcp
GOOGLE_CALENDAR_MCP_URL=http://localhost:8086/mcp
GMAIL_MCP_URL=http://localhost:8087/mcp

# Gmail/Discord/Calendar credentials (DISCORD_TOKEN, GOOGLE_CLIENT_SECRETS_FILE,
# GMAIL_MCP_*) live in codebase/mcp/.env, not here — server.py loads that
# file too (see env_loader.py).

# Unified Google connection ("Quản lý kết nối" > Gmail), shared by
# google_calendar_mcp and gmail_mcp — see google_connection.py.
# Requires a Web application OAuth client (Google Cloud Console) whose JSON
# is saved at codebase/backend/credentials/client_secret.json (gitignored;
# override the path with GOOGLE_OAUTH_CLIENT_SECRETS_FILE). Register
# GOOGLE_OAUTH_REDIRECT_URI as an Authorized redirect URI on that client.
# google_calendar_mcp (separate process) must point at the same files —
# see GOOGLE_CLIENT_SECRETS_FILE / GOOGLE_CALENDAR_TOKEN_FILE in
# codebase/mcp/.env.example.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
# Where the FE dev server runs (scripts/dev.sh default) — the OAuth callback
# redirects back here after connecting/disconnecting.
FRONTEND_URL=http://localhost:5190

# Opt-out for studypulse/discord_ingest.py, which ingests every text/
# announcement channel in a newly-seen guild by default ("get all content
# and chunk it", not a per-message prefilter like mail's isRead check).
# Comma-separated Discord snowflake ids; empty = nothing excluded.
DISCORD_INGEST_CHANNEL_DENYLIST=
DISCORD_INGEST_GUILD_DENYLIST=
